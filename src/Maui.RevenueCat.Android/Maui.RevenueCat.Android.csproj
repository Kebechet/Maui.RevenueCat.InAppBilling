<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>
		<!--min.supported version v23 is from RevenueCat SDK 10.x-->
		<!--also matches MAUI: https://learn.microsoft.com/en-us/dotnet/maui/supported-platforms-->
		<SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup Label="NugetProperties">
		<Authors>Kebechet</Authors>
		<IsPackable>true</IsPackable>
		<PackageId>Kebechet.Maui.RevenueCat.Android</PackageId>
		<Description>Contains bindings for https://docs.revenuecat.com/docs/android</Description>
		<RepositoryUrl>https://github.com/Kebechet/Maui.RevenueCat.Android</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Kebechet/Maui.RevenueCat.Android</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>icon.png</PackageIcon>
		<OutputType>Library</OutputType>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>embedded</DebugType>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedAllSources>true</EmbedAllSources>
		<Version>11.1.0.0</Version>
		<PackageReleaseNotes>11.1.0.0: RevenueCat Android SDK updated from 10.16.1 to 11.1.0. RevenueCat SDK changes per version (RevenueCatUI is not bound):
10.16.2: fix: don't share a MessageDigest across coroutines in FontLoader and DefaultFileCache. Fix misleading ui_config warnings for projects without paywalls. fix: Declare kotlinx-coroutines-android as a dependency. fix(paywalls): prewarm the current offering's workflow assets on load.
10.17.0: feat(ads): fire reward-verification tracking events from the poll. fix(paywalls): don't leave a hidden package selected by default.
10.18.0: Track checkpoint hits through the analytics events pipeline. Add public Purchases.showManageSubscriptions() API. feat(ads): ad reward tracking with admob adapter.
10.18.1: Don't jitter developer-initiated subscriber attribute posts in foreground.
10.19.0: feat(singular): add $singularDeviceId subscriber attribute for Singular V2. Add awaitShowManageSubscriptions.
10.19.1: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.20.0: Narrow consumer R8 rules. Surface attribute sync errors when fetching offerings. Fall back to "en" when a paywall screen omits default_locale. Cache web purchase redemption CustomerInfo for the initiating App User ID.
10.21.0: fix: send X-Is-Sandbox header when using a Test Store API key. fix: floating-point rounding bug in Test Store priceString.
10.21.1: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.22.0: Create the signature verifier off the configure() thread.
10.22.1: Do not apply a previous user's CustomerInfo after an identity change.
10.23.0: feat(admob): add next-gen SDK support. Treat a -1 HTTP status code as a connection error. fix: bypass app-installed HTTP response caches for API requests.
10.23.1: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.23.2: Skip obfuscatedAccountId when the device already owns the subscription being purchased.
10.23.3: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.23.4: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.24.0: Track rewarded ad prompt shown and accepted events.
10.24.1: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.24.2: Fix backend prices losing a micro when converted to amountMicros.
10.25.0: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.26.0: feat(paywalls): introduce video localization support for Android.
10.27.0: feat(ads): allow manual rewarded ad earned tracking. Fix IAM retries when switching users.
10.27.1: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.28.0: Add LevelPlay manual ad tracking sample.
10.28.1: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
10.29.0: Skip the Blockstore alias path when the Blockstore client is unavailable.
10.30.0: Parse paywall gating in checkpoint workflows. fix(checkpoints): track started Activities from process start. fix: keep the cached offerings response out of SharedPreferences to reduce memory usage. Fix dropped Billing callbacks after disconnection. Fix requests hanging indefinitely when the server stops responding. Fix non-subscription transactions reporting "null" display name and store transaction ID.
10.30.1: no RevenueCat SDK changes listed (RevenueCatUI or internal changes only).
11.0.0: WARNING: Your app, and any library module that depends on the SDK, must now compile against API 35 or later. This requirement comes from androidx.core 1.15.0, which Play Billing Library 9 depends on. minSdk and targetSdk are not affected. BREAKING: Update to Play Billing Library 9.1.0. BREAKING: Update to AGP 9 (AGP 9.2.1, Gradle 9.4.1, Kotlin 2.2.21). Fix paywall image localization parsing under kotlinx-serialization 1.7.3.
11.0.1: Fail the pending purchase when Play completes another base plan.
11.1.0: Expose configured ad rewards as a preview API. fix: preserve workflow context in custom paywall impressions.
Full changelog: https://github.com/RevenueCat/purchases-android/releases</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<!--The AAR is downloaded from Maven Central and its POM drives Java dependency
		verification, so every RevenueCat bump cross-checks the PackageReference list below.-->
		<AndroidMavenLibrary Include="com.revenuecat.purchases:purchases" Version="11.1.0" />
		<!--RevenueCat uses Poko only as a compile-time Gradle plugin and @Poko is
		source-retention, so the POM's runtime dependency has no bytecode footprint.
		Referencing a binding for it caused #83 and #114.-->
		<AndroidIgnoredJavaDependency Include="dev.drewhamilton.poko:poko-annotations:0.20.2" />
	</ItemGroup>

	<ItemGroup>
    <!--Compile Dependencies-->
    <PackageReference Include="Xamarin.Android.Google.BillingClient" Version="9.1.0" />
		<PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0" />

    <!--Runtime Dependencies-->
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.10.0" />
		<PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.GooglePlayServices.Ads.Identifier" Version="118.1.0.3" />
		<PackageReference Include="Xamarin.Google.Crypto.Tink.Android" Version="1.15.0.1" />
		<!--Dev.Drewhamilton.Poko.PokoAnnotations is intentionally NOT referenced: RevenueCat uses Poko only as a compile-time Gradle plugin and @Poko is source-retention, so it leaves no trace in the purchases AAR bytecode. Referencing it only pulled in Dependencies.Gradle/SharpCompress (#114) and broke Windows builds (#83).-->
		<PackageReference Include="Xamarin.Kotlin.Parcelize.Runtime" Version="2.4.0" />
    <PackageReference Include="Xamarin.KotlinX.Serialization.Json" Version="1.7.3.5" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="1.11.0" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.11.0" />
    <PackageReference Include="Xamarin.AndroidX.Startup.StartupRuntime" Version="1.2.0.7" />
    <PackageReference Include="Xamarin.GooglePlayServices.Auth.BlockStore" Version="116.4.0.8" />

    <!--fixed amazon warnings-->
    <PackageReference Include="Eddys.Amazon.AppStoreSdk.Binding" Version="3.0.3" />

		<!--fixed build error "androidx.collection.ArrayMapKt is defined multiple times"-->
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.9.2" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.2" />

    <!--Fragment.Ktx 1.8.8 bug requires this: https://github.com/dotnet/android-libraries/issues/1186
    https://github.com/dotnet/android-libraries/issues/1181#issuecomment-3053297891-->
    <PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.4.0.2" />

		<!--because MAUI has built-in different versions: https://github.com/dotnet/android/issues/9698-->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.10.0.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>

		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>

		<None Include="..\..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
